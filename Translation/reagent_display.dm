/datum/reagents/proc/DisplayNames()
	var/list/names = list()
	for(var/datum/reagent/reagent in reagent_list)
		names += reagent.DisplayName()
	return names.Join("、")

/proc/RecordedReagentNames(list/recipe, list/name_to_reagent)
	if(!length(recipe))
		return
	var/list/names = list()
	for(var/key in recipe)
		var/datum/reagent/reagent_type = name_to_reagent[translate_legacy_chem_id(key)]
		names[key] = reagent_type ? ReagentNameForDisplay(initial(reagent_type.name)) : key
	return names
